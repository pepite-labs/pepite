    <Compile Include="..\Predict.Keyboard\VoiceId.cs" Link="VoiceId.cs" />
    <Compile Include="..\Predict.Keyboard\PiperVoicePack.cs" Link="PiperVoicePack.cs" />
    <Compile Include="..\Predict.Keyboard\EngineRouter.cs" Link="EngineRouter.cs" />
    <Compile Include="..\Predict.Keyboard\PiperResidency.cs" Link="PiperResidency.cs" />
    <Compile Include="..\Predict.Keyboard\PiperWordCache.cs" Link="PiperWordCache.cs" />
    <Compile Include="..\Predict.Keyboard\SentenceEchoGate.cs" Link="SentenceEchoGate.cs" />
    <Compile Include="..\Predict.Keyboard\Liaison.cs" Link="Liaison.cs" />
    <Compile Include="..\Predict.Keyboard\AudioSink.cs" Link="AudioSink.cs" />
    <!-- single instance and start-up feedback (welcome window) -->
    <Compile Include="..\Predict.Keyboard\StartupPolicy.cs" Link="StartupPolicy.cs" />
    <Compile Include="..\Predict.Keyboard\SingleInstance.cs" Link="SingleInstance.cs" />
    <!-- plan « aide intégrée »: help targets, the fallback chain, the tray menu order -->
    <Compile Include="..\Predict.Keyboard\HelpLinks.cs" Link="HelpLinks.cs" />
