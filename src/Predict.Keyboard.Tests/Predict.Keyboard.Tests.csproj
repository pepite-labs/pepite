    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Predict.Keyboard.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Predict.Keyboard\ContextExtractor.cs" Link="ContextExtractor.cs" />
