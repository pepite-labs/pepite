<Window x:Class="Predict.Keyboard.ReadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Predict.Keyboard"
        Title="{x:Static local:Strings.ReadWindowTitle}" ResizeMode="CanResize" WindowStartupLocation="Manual"
        ShowInTaskbar="True" Topmost="True" Background="#FF1F2937" UseLayoutRounding="True" MinWidth="300" MinHeight="200"
        AutomationProperties.AutomationId="ReadingWindow">
  <!-- plan 07 « grande fenêtre »: the same reading view as the bar (ReadingView, built in code), resizable, scrolls to the
       word being read -->
  <Border x:Name="Host" Padding="8"/>
</Window>
