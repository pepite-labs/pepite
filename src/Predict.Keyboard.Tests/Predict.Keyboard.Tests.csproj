    <Compile Include="..\Predict.Keyboard\DataSearch.cs" Link="DataSearch.cs" />
    <Compile Include="..\Predict.Keyboard\CommandLine.cs" Link="CommandLine.cs" />
    <Compile Include="..\Predict.Keyboard\OpenRequest.cs" Link="OpenRequest.cs" />
    <Compile Include="..\Predict.Keyboard\InstallInfo.cs" Link="InstallInfo.cs" />
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="host\**" />
    <None Include="..\Predict.Keyboard\Assets\*.ico" Link="Assets\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- the golden native test runs only when Data.Build/build_espeak.ps1 has staged espeak-ng (git-ignored) -->
  <PropertyGroup Condition="Exists('..\Data.Build\out\espeak\libespeak-ng.dll')">
    <DefineConstants>$(DefineConstants);HAVE_ESPEAK</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="Exists('..\Data.Build\out\espeak\libespeak-ng.dll')">
    <None Include="..\Data.Build\out\espeak\libespeak-ng.dll" Link="libespeak-ng.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Data.Build\out\espeak\espeak-ng-data\**" Link="espeak-ng-data\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Predict.Core is pure .NET (no WPF): referenced, not linked (Elision, Tokenizer, Suggestion) -->
    <ProjectReference Include="..\Predict.Core\Predict.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.3.2" />
    <PackageReference Include="xunit" Version="2.4.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.5" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="6.0.25" />
    <PackageReference Include="System.Drawing.Common" Version="6.0.0" />
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <!-- the engine's model type (0.7.2 tests run a fake model; same package and version as the app) -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.1" />
  </ItemGroup>
</Project>
