<Window x:Class="Predict.Keyboard.SuggestionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Predict.Keyboard"
        Title="{x:Static local:Strings.AppName}" WindowStyle="None" ResizeMode="NoResize" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False" SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual" Left="-10000" Top="-10000"
        Background="#FF1F2937" Focusable="False" UseLayoutRounding="True">
  <Border BorderBrush="#FF4B5563" BorderThickness="1" Padding="3">
    <StackPanel Orientation="Horizontal">
      <!-- free position (D9): drag the bar by this grip; dots drawn as shapes, no font dependency -->
      <Border x:Name="Grip" Width="14" Margin="0,3,2,3" Background="#01FFFFFF" Cursor="SizeAll" Visibility="Collapsed"
              AutomationProperties.AutomationId="Grip" AutomationProperties.Name="{x:Static local:Strings.GripName}"
              ToolTip="{x:Static local:Strings.GripHint}">
        <UniformGrid Columns="2" Rows="3" Width="10" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center">
          <Ellipse Width="3" Height="3" Fill="#FF9CA3AF"/>
          <Ellipse Width="3" Height="3" Fill="#FF9CA3AF"/>
          <Ellipse Width="3" Height="3" Fill="#FF9CA3AF"/>
          <Ellipse Width="3" Height="3" Fill="#FF9CA3AF"/>
          <Ellipse Width="3" Height="3" Fill="#FF9CA3AF"/>
          <Ellipse Width="3" Height="3" Fill="#FF9CA3AF"/>
        </UniformGrid>
      </Border>
      <!-- plan 10B: the spelling marker (✓ ≈ ?) left of the words, built in code (BarBuilder.MakeMarker) -->
      <ContentControl x:Name="MarkerHost" Focusable="False" Visibility="Collapsed" VerticalAlignment="Center"/>
      <StackPanel x:Name="Bar" Orientation="Horizontal"/>
      <!-- plan 07: reading mode (tiles of the selected text), built in code (ReadingView) -->
      <ContentControl x:Name="ReadingHost" Visibility="Collapsed" Focusable="False" AutomationProperties.AutomationId="Reading"/>
    </StackPanel>
  </Border>
</Window>
