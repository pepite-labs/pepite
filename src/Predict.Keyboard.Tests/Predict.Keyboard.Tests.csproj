    <Compile Include="..\Predict.Keyboard\NamesImport.cs" Link="NamesImport.cs" />
    <Compile Include="..\Predict.Keyboard\WordPictures.cs" Link="WordPictures.cs" />
    <!-- 0.7.2: pierre's word carrier and phoneme fix; the engine itself (fake model) for the word path -->
    <Compile Include="..\Predict.Keyboard\PiperCarrier.cs" Link="PiperCarrier.cs" />
    <Compile Include="..\Predict.Keyboard\PiperModel.cs" Link="PiperModel.cs" />
    <Compile Include="..\Predict.Keyboard\PiperSynth.cs" Link="PiperSynth.cs" />
