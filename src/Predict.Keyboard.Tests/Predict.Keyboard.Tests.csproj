    <Compile Include="..\Predict.Keyboard\EditClassifier.cs" Link="EditClassifier.cs" />
    <Compile Include="..\Predict.Keyboard\ReadingDocument.cs" Link="ReadingDocument.cs" />
    <Compile Include="..\Predict.Keyboard\ReadingController.cs" Link="ReadingController.cs" />
    <Compile Include="..\Predict.Keyboard\SelectionPolicy.cs" Link="SelectionPolicy.cs" />
    <!-- plan 08a: Piper voices (pure parts + the espeak P/Invoke for the golden test) -->
