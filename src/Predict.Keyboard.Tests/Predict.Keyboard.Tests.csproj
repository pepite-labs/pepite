    <Compile Include="..\Predict.Keyboard\WordListStore.cs" Link="WordListStore.cs" />
    <Compile Include="..\Predict.Keyboard\WordListService.cs" Link="WordListService.cs" />
    <Compile Include="..\Predict.Keyboard\WordTextFile.cs" Link="WordTextFile.cs" />
