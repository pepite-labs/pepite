<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- the visible name is « Pépite » (owner 2026-11-14); project and namespaces stay Predict.* -->
    <AssemblyName>Pepite</AssemblyName>
    <RootNamespace>Predict.Keyboard</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>0.10.2</Version>
    <Product>Pépite</Product>
    <!-- FileDescription: the name Windows shows in Task Manager and on notifications -->
    <AssemblyTitle>Pépite</AssemblyTitle>
    <Description>Pépite — prédiction de mots</Description>
    <Company>Les auteurs de Pépite</Company>
    <!-- D18: no personal name; a code-signing certificate will still show its holder as the publisher -->
    <Copyright>© 2026 Les auteurs de Pépite</Copyright>
    <!-- plan 12: French only (D14) — no satellite resource folders (de, es, ja, …) in the publish / the installer -->
    <SatelliteResourceLanguages>fr</SatelliteResourceLanguages>
    <!-- one place for the System.Speech version: the PackageReference and the path of its licence files -->
    <PepiteSystemSpeechVersion>10.0.15</PepiteSystemSpeechVersion>
    <!-- the NuGet package folder with exactly one trailing separator: NUGET_PACKAGES set without one gave
         "...nugetmicrosoft.ml.onnxruntime" (MSB3030) -->
    <PepitePackageRoot>$([MSBuild]::EnsureTrailingSlash('$(NuGetPackageRoot)'))</PepitePackageRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Predict.Core\Predict.Core.csproj" />
    <PackageReference Include="System.Speech" Version="$(PepiteSystemSpeechVersion)" />
    <!-- plan 08a (D19: MIT, GPL-3-compatible): Piper voices on ONNX Runtime, played through WASAPI -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.1" />
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>
  <ItemGroup>
    <!-- the « pépite » logo (branding/pepite.svg): tray / windows / À propos icons (Data.Build/make_icon.py), loaded as Predict.Keyboard.Assets.<name> -->
    <EmbeddedResource Include="Assets\*.ico" LogicalName="Predict.Keyboard.Assets.%(Filename)%(Extension)" />
    <None Include="Assets\app.svg" />
  </ItemGroup>
  <!-- bundled OFL fonts (D16, Data.Build/fetch_fonts.py): byte-identical upstream files, each folder with its OFL.txt -->
  <ItemGroup Condition="Exists('..\Data.Build\out\fonts')">
    <None Include="..\Data.Build\out\fonts\**" Link="fonts\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- plan 12: the prediction database (Lexique 3.83 CC BY-SA 4.0 + corpus counts, Data.Build/build_db.py), copied like the other packs (it was copied by hand up to 0.9.0) -->
  <ItemGroup Condition="Exists('..\Data.Build\out\prediction.sqlite')">
    <None Include="..\Data.Build\out\prediction.sqlite" Link="prediction.sqlite" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- plan corpus-light (Phase 2): the database's sources, versions, licences and SHA-256 (CC BY-SA 4.0 data; Data.Build/corpus/write_sources.py) -->
  <ItemGroup Condition="Exists('..\Data.Build\out\prediction-SOURCES.txt')">
    <None Include="..\Data.Build\out\prediction-SOURCES.txt" Link="prediction-SOURCES.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- ARASAAC picture pack (CC BY-NC-SA 4.0, a separate file): shipped only together with its licence notice -->
  <ItemGroup Condition="Exists('..\Data.Build\out\pictos.sqlite') And Exists('..\Data.Build\out\ARASAAC-LICENCE.txt')">
    <None Include="..\Data.Build\out\pictos.sqlite" Link="pictos.sqlite" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Data.Build\out\ARASAAC-LICENCE.txt" Link="ARASAAC-LICENCE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- plan 10C: the « Noms propres » open-data pack (CC BY 4.0, Data.Build/pepite-noms/build_names.py), a separate folder with its licence and sources -->
  <ItemGroup Condition="Exists('..\Data.Build\out\noms-pack\noms\noms.json') And Exists('..\Data.Build\out\noms-pack\noms\LICENCE.txt')">
    <None Include="..\Data.Build\out\noms-pack\noms\**" Link="noms\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- plan 11 (10D-1): the morphology table derived from Grammalecte French.lex (MPL-2.0, Data.Build/build_grammar.py), a separate file shipped with its SOURCE.txt and the MPL text -->
  <ItemGroup Condition="Exists('..\Data.Build\out\grammar.sqlite') And Exists('..\Data.Build\out\grammar\SOURCE.txt') And Exists('..\Data.Build\out\grammar\MPL-2.0.txt')">
    <None Include="..\Data.Build\out\grammar.sqlite" Link="grammar.sqlite" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Data.Build\out\grammar\SOURCE.txt" Link="grammar\SOURCE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Data.Build\out\grammar\MPL-2.0.txt" Link="grammar\MPL-2.0.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- publication cleanup (S6): the spelling indicator's reference derived from Grammalecte French.lex (MPL-2.0,
       Data.Build/build_spelling_ref.py), a separate file shipped with its SOURCE.txt and the MPL text -->
  <ItemGroup Condition="Exists('..\Data.Build\out\spelling.sqlite') And Exists('..\Data.Build\out\spelling\SOURCE.txt') And Exists('..\Data.Build\out\spelling\MPL-2.0.txt')">
    <None Include="..\Data.Build\out\spelling.sqlite" Link="spelling.sqlite" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Data.Build\out\spelling\SOURCE.txt" Link="spelling\SOURCE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Data.Build\out\spelling\MPL-2.0.txt" Link="spelling\MPL-2.0.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- plan 08a: espeak-ng (GPL-3.0-or-later, Data.Build/build_espeak.ps1) with its licence and build record -->
  <ItemGroup Condition="Exists('..\Data.Build\out\espeak\libespeak-ng.dll')">
    <None Include="..\Data.Build\out\espeak\libespeak-ng.dll" Link="libespeak-ng.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Data.Build\out\espeak\espeak-ng-data\**" Link="espeak-ng-data\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Data.Build\out\espeak\COPYING" Link="licenses\espeak-ng\COPYING" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Data.Build\out\espeak\SOURCE.txt" Link="licenses\espeak-ng\SOURCE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- plans 08a/08b: Piper voice packs (siwis CC BY 4.0; pierre CC BY-SA 4.0, "public": false = test releases only, D28; Data.Build/fetch_voices.py), each folder with its licence and change notice -->
  <ItemGroup Condition="Exists('..\Data.Build\out\voices')">
    <None Include="..\Data.Build\out\voices\**" Exclude="..\Data.Build\out\voices\**\.packed-by-fetch_voices" Link="voices\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- the app's licence and the third-party notices (D19); the MIT notices of ONNX Runtime (from its package) and NAudio -->
  <ItemGroup>
    <None Include="..\..\COPYING" Link="COPYING" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(PepitePackageRoot)microsoft.ml.onnxruntime\1.31.1\LICENSE" Link="licenses\onnxruntime\LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(PepitePackageRoot)microsoft.ml.onnxruntime\1.31.1\ThirdPartyNotices.txt" Link="licenses\onnxruntime\ThirdPartyNotices.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\licenses\naudio\license.txt" Link="licenses\naudio\license.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- publication cleanup (S6): the licences of what a self-contained publish ships — the .NET and Windows Desktop runtime
       packs (MIT + their third-party notices), System.Speech (MIT) and the Apache-2.0 text for SQLitePCLRaw; the versions
       follow THIRD-PARTY-NOTICES.txt (release_lint.py checks them against Pepite.deps.json). The System.Speech notices and
       Apache-2.0 ship with every build; the runtime-pack licences are added by PepiteRuntimePackLicenses below. Since
       .NET 10 the System.Speech package no longer carries LICENSE.TXT: it is the dotnet/runtime MIT licence, so the
       target below takes it from the resolved .NETCore runtime pack (same text) -->
  <ItemGroup>
    <None Include="$(PepitePackageRoot)system.speech\$(PepiteSystemSpeechVersion)\THIRD-PARTY-NOTICES.TXT" Link="licenses\system-speech\THIRD-PARTY-NOTICES.TXT" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\licenses\apache-2.0\LICENSE.txt" Link="licenses\apache-2.0\LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- plan 13 (first CI installer run): the runtime-pack licences come from the packs the SDK actually resolved
       (ResolvedRuntimePack.PackageDirectory), not from a hard-coded version folder: a different SDK patch resolves other
       packs, and an Exists() condition on a fixed path then left the .NET licences out of the installer silently.
       Self-contained RID builds only (a framework-dependent dev build ships no runtime); a missing file is an error. -->
  <Target Name="PepiteRuntimePackLicenses" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolveFrameworkReferences"
          Condition="'$(RuntimeIdentifier)' != '' and '$(SelfContained)' == 'true'">
    <ItemGroup>
      <_PepiteNetCorePack Include="@(ResolvedRuntimePack)" Condition="'%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.NETCore.App'" />
      <_PepiteDesktopPack Include="@(ResolvedRuntimePack)" Condition="'%(ResolvedRuntimePack.FrameworkName)' == 'Microsoft.WindowsDesktop.App'" />
    </ItemGroup>
    <PropertyGroup>
      <_PepiteNetCorePackDir>@(_PepiteNetCorePack->'%(PackageDirectory)'->Distinct())</_PepiteNetCorePackDir>
      <_PepiteDesktopPackDir>@(_PepiteDesktopPack->'%(PackageDirectory)'->Distinct())</_PepiteDesktopPackDir>
    </PropertyGroup>
    <Error Condition="'$(_PepiteNetCorePackDir)' == '' or '$(_PepiteDesktopPackDir)' == '' or $(_PepiteNetCorePackDir.Contains(';')) or $(_PepiteDesktopPackDir.Contains(';'))"
           Text="Pépite: cannot locate the resolved .NET / Windows Desktop runtime packs (got '$(_PepiteNetCorePackDir)' and '$(_PepiteDesktopPackDir)'); their licences must ship with a self-contained publish." />
    <ItemGroup>
      <_PepiteRuntimeLicense Include="$(_PepiteNetCorePackDir)\LICENSE.TXT" Link="licenses\dotnet\LICENSE.TXT" />
      <_PepiteRuntimeLicense Include="$(_PepiteNetCorePackDir)\THIRD-PARTY-NOTICES.TXT" Link="licenses\dotnet\THIRD-PARTY-NOTICES.TXT" />
      <_PepiteRuntimeLicense Include="$(_PepiteDesktopPackDir)\LICENSE" Link="licenses\windowsdesktop\LICENSE" />
      <_PepiteRuntimeLicense Include="$(_PepiteNetCorePackDir)\LICENSE.TXT" Link="licenses\system-speech\LICENSE.TXT" />
    </ItemGroup>
    <Error Condition="!Exists('%(_PepiteRuntimeLicense.Identity)')"
           Text="Pépite: licence file missing from the resolved runtime pack: %(_PepiteRuntimeLicense.Identity) (needed as %(_PepiteRuntimeLicense.Link) in a self-contained publish)." />
    <ItemGroup>
      <None Include="@(_PepiteRuntimeLicense)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
  <!-- plan « aide intégrée »: the embedded help (static French pages, CC BY-SA 4.0; prefs.js GPL) in aide\, its
       contributor notes excepted; the bundled fonts copied again into aide\fonts\ (Firefox refuses a font from a parent
       folder of a local page), each with its OFL.txt; the school deployment guide next to the exe (owner Q6), linked
       from the help -->
  <ItemGroup>
    <None Include="..\..\aide\**" Exclude="..\..\aide\README.md;..\..\aide\fonts\**" Link="aide\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\installer\DEPLOIEMENT.txt" Link="DEPLOIEMENT.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="Exists('..\Data.Build\out\fonts')">
    <None Include="..\Data.Build\out\fonts\**\*.ttf;..\Data.Build\out\fonts\**\*.otf;..\Data.Build\out\fonts\**\OFL.txt" Link="aide\fonts\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- A13: app-local Visual C++ 2015-2022 x64 runtime for onnxruntime.dll (Data.Build/stage_vcruntime.ps1, git-ignored) -->
  <ItemGroup Condition="Exists('..\Data.Build\out\vcruntime\vcruntime140.dll')">
    <None Include="..\Data.Build\out\vcruntime\*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\Data.Build\out\vcruntime\SOURCE.txt" Link="licenses\vcruntime\SOURCE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- the ONNX Runtime package also ships its import libraries (.lib): not needed at run time -->
  <Target Name="DropOrtImportLibs" AfterTargets="Publish">
    <Delete Files="$(PublishDir)onnxruntime.lib;$(PublishDir)onnxruntime_providers_shared.lib" />
  </Target>
</Project>
